{
  "name": "promptool",
  "version": "1.0.0",
  "description": "prompTOR prompt engineering tool",
  "type": "module",
  "scripts": {
    "dev": "nuxt dev --host 0.0.0.0 --port 3000",
    "build": "nuxt build",
    "generate": "nuxt generate",
    "preview": "nuxt preview --host 0.0.0.0 --port 3000",
    "start": "node .output/server/index.mjs",
    "test": "node --test tests/*.test.mjs",
    "check": "node checks/single-page.mjs && node checks/no-class-strings.mjs && node checks/type-floor.mjs && node checks/no-export.mjs",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build"
  },
  "dependencies": {
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.13.1",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@lezer/highlight": "^1.2.5",
    "@nuxt/ui": "^4.12.0",
    "@replit/codemirror-vim": "^6.4.0",
    "@tauri-apps/api": "^2",
    "express": "^5.2.1",
    "highlight.js": "^11.11.1",
    "lucide-vue-next": "^0.475.0",
    "nuxt": "^4.6.2",
    "vue": "^3.5.44",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2"
  }
